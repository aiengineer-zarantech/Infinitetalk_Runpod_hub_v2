# ==============================================================================
# DO NOT BUILD (decision 2026-11-03): a ~66 GB image pulls too slowly on new serverless hosts.
# Kept for reference only. The v34 that gets built is Dockerfile.v34 (MODEL_SOURCE=hf_cache).
# It also predates the v34 timing / fp8 changes and does not copy those files.
# ==============================================================================
# Dockerfile.v34.baked - models BAKED into the image, SeedVR2 lazy, separate_vocals=false (branch perf/5090-speedup)
# ==============================================================================
# - The 8 startup models (~29.3 GB) + InfiniteTalk Multi (2.7 GB) are downloaded from their public
#   huggingface.co sources at BUILD time into /models_baked/<folder>/<file>, size checked, one layer per big file.
#   MODEL_SOURCE=baked links them into /ComfyUI/models with no copy: cold start no longer reads ~29 GB from
#   the network volume. A missing baked file falls back to the volume (HF_CACHE_FALLBACK=1).
# - SeedVR2 (3b + VAE, ~7.3 GB) is no longer copied at startup: first upscale job only
#   (UPSCALE_MODELS_AT_STARTUP=1 restores the old behaviour).
# - separate_vocals=false in the job input skips MelBandRoFormer (backend TTS_SKIP_VOCAL_SEPARATION=1).
# - Includes all of v33 (resilient copy, hf_cache, ComfyUI-Manager off).
#
# Build host needs ~110 GB free Docker storage (base ~34 GB + models ~32 GB + layer export). Image ~66 GB.
#   docker build -f Dockerfile.v34 -t <registry>/infinitetalk-runpod:v34 .
#
# SECURITY: the v32 base still has an old layer with a RunPod key in test_worker_diag.py / test_mutations.py /
# download_all_models.py. They are deleted below, but a deleted file stays readable in the lower layer.
# Make sure that key is revoked in the RunPod console, and push v34 to a PRIVATE repository.
ARG BASE_IMAGE=digamberjhazaran/infinitetalk-runpod@sha256:423a8e0cd3a42ca4d26d82fffbae3292f76dcd0ba988a0280bfb703bc4970652
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

# 1. The files replaced below must be the v32 ones
RUN echo "8fe96d8694a504d5ac643429e03be9a85c857828c31a74f501ba093663734d55  /setup_models.py" | sha256sum -c --quiet && \
    echo "51ee2f6ac2d8d0f260ffda93052317400154198a5075fbdce79d81b2664aaabe  /entrypoint.sh" | sha256sum -c --quiet && \
    echo "07b8f9bc4574aff6990ce7e1bbb50d314fd8eeda5d39fdfdd99e0deed28d56fe  /handler.py" | sha256sum -c --quiet && \
    /usr/bin/python3.10 -m pip freeze > /tmp/comfy_freeze_pre.txt && \
    rm -f /test_worker_diag.py /test_mutations.py /download_all_models.py

# 2. Baked models. fetch <url> <folder> <expected bytes>
RUN printf '%s\n' '#!/bin/bash' 'set -euo pipefail' \
      'url="$1"; dir="/models_baked/$2"; want="$3"; f="$dir/$(basename "${url%%\?*}")"' \
      'mkdir -p "$dir"' \
      'curl -fL --retry 8 --retry-all-errors --retry-delay 5 -C - -o "$f" "$url"' \
      'have=$(stat -c %s "$f"); [ "$have" = "$want" ] || { echo "SIZE MISMATCH $f: $have != $want"; exit 1; }' \
      'echo "baked $f ($have bytes)"' > /usr/local/bin/fetch_model && chmod 755 /usr/local/bin/fetch_model
ARG HF=https://huggingface.co
RUN fetch_model $HF/Kijai/WanVideo_comfy/resolve/main/Wan2_1-I2V-14B-480P_fp8_e4m3fn.safetensors diffusion_models 16993877896
RUN fetch_model $HF/Kijai/WanVideo_comfy/resolve/main/umt5-xxl-enc-fp8_e4m3fn.safetensors text_encoders 6731333792
RUN fetch_model $HF/Kijai/WanVideo_comfy_fp8_scaled/resolve/main/InfiniteTalk/Wan2_1-InfiniteTalk-Single_fp8_e4m3fn_scaled_KJ.safetensors diffusion_models 2713548210
RUN fetch_model $HF/Kijai/WanVideo_comfy_fp8_scaled/resolve/main/InfiniteTalk/Wan2_1-InfiniteTalk-Multi_fp8_e4m3fn_scaled_KJ.safetensors diffusion_models 2712729090
RUN fetch_model $HF/Comfy-Org/Wan-2.1/resolve/main/split_files/clip_vision/clip_vision_h.safetensors clip_vision 1264219396 && \
    fetch_model $HF/Kijai/WanVideo_comfy/resolve/main/Lightx2v/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors loras 738005744 && \
    fetch_model $HF/Kijai/MelBandRoFormer_comfy/resolve/main/MelBandRoformer_fp16.safetensors diffusion_models 456479072 && \
    fetch_model $HF/Kijai/WanVideo_comfy/resolve/main/Wan2_1_VAE_bf16.safetensors vae 253806278 && \
    fetch_model $HF/Kijai/wav2vec2_safetensors/resolve/main/wav2vec2-chinese-base_fp16.safetensors diffusion_models 190115368

# 3. v34 code
COPY setup_models.py /setup_models.py
COPY entrypoint.sh /entrypoint.sh
COPY handler.py /handler.py
COPY worker_guard/vocals.py /worker_guard/vocals.py
RUN sed -i 's/\r$//' /setup_models.py /entrypoint.sh /handler.py && chmod 755 /setup_models.py /entrypoint.sh && \
    bash -n /entrypoint.sh && \
    cd / && MODEL_SOURCE=baked python -c "import setup_models, worker_guard.vocals as v; \
assert setup_models.model_source() == 'baked' and not setup_models.upscale_at_startup(); \
d = setup_models.linked_source_dir(); \
missing = [m for m, s in setup_models.MODEL_DESTINATIONS.items() if not setup_models.hf_cache_file(d, m, s)]; \
assert not missing, missing; print('baked models OK in', d)" && \
    rm -rf /worker_guard/__pycache__ /__pycache__

ENV MODEL_SOURCE=baked \
    BAKED_MODELS_DIR=/models_baked \
    UPSCALE_MODELS_AT_STARTUP=0

# 4. Zero package drift
RUN /usr/bin/python3.10 -m pip freeze > /tmp/comfy_freeze_post.txt && \
    diff -u /tmp/comfy_freeze_pre.txt /tmp/comfy_freeze_post.txt && rm -f /tmp/comfy_freeze_*.txt && \
    echo "OK: v34 built, zero package drift"
