# ==============================================================================
# Dockerfile.v33 - fast, resilient model setup on top of v32 (branch perf/5090-speedup). NOT BUILT YET.
# ==============================================================================
# - setup_models.py: range reads retried (COPY_RANGE_RETRIES=5, backoff 1..16 s, source reopened), a failed file is
#   retried and RESUMED (COPY_FILE_RETRIES=3, <file>.tmp.progress), the disk check counts the startup SeedVR2 copy.
#   Before: one GeeseFS read error -> exit 1 -> container restart -> the ~29 GB copy from zero.
# - MODEL_SOURCE=hf_cache (default volume): RunPod Cached Models are linked from
#   /runpod-volume/huggingface-cache/hub/models--<org>--<name>/snapshots/<hash>/ with no copy (HF_CACHE_REPO,
#   HF_CACHE_ROOT, HF_CACHE_REVISION, HF_CACHE_FALLBACK=1). [TIMING] model setup line at the end.
# - entrypoint.sh: COMFYUI_MANAGER=0 (default) renames custom_nodes/ComfyUI-Manager to *.disabled at startup (no
#   network calls); compile cache never inside the HF cache; [MODELS] line with MODEL_SOURCE and the volume state.
# Replaces /setup_models.py and /entrypoint.sh only. handler, worker_guard, workflows, custom nodes, ComfyUI core
# and all Python packages are inherited from v32 unchanged (checked below). Installs nothing.
#
# BASE: v32 amd64 by digest. If the endpoint runs another tag (worker log "[ACCEL] ... nag on, scale 11.0" = v28/29,
# "scale 3.0" = v30+), change BASE_IMAGE only; the fingerprint checks then tell whether these files still fit.
# SECURITY: the v32 base still contains an old layer with test_worker_diag.py / test_mutations.py /
# download_all_models.py that hold a RunPod API key. Rotate that key before pushing anything; keep the repo private.
ARG BASE_IMAGE=digamberjhazaran/infinitetalk-runpod@sha256:423a8e0cd3a42ca4d26d82fffbae3292f76dcd0ba988a0280bfb703bc4970652
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

# 1. Baseline freeze + fingerprints: the two files replaced here must be the v32 ones, the rest must not change
RUN /usr/bin/python3.10 -m pip freeze > /tmp/comfy_freeze_pre.txt && \
    echo "8fe96d8694a504d5ac643429e03be9a85c857828c31a74f501ba093663734d55  /setup_models.py" | sha256sum -c --quiet && \
    echo "51ee2f6ac2d8d0f260ffda93052317400154198a5075fbdce79d81b2664aaabe  /entrypoint.sh" | sha256sum -c --quiet && \
    echo "07b8f9bc4574aff6990ce7e1bbb50d314fd8eeda5d39fdfdd99e0deed28d56fe  /handler.py" | sha256sum -c --quiet && \
    sha256sum /handler.py /extra_model_paths.yaml /Upscale_SeedVR2.json \
        /I2V_single.json /I2V_multi.json /V2V_single.json /V2V_multi.json \
        /I2V_single_compiled.json /I2V_multi_compiled.json > /tmp/unchanged.sha256 && \
    find /worker_guard -type f -name '*.py' -print0 | sort -z | xargs -0 sha256sum >> /tmp/unchanged.sha256 && \
    find /ComfyUI/custom_nodes -type f -not -path '*/__pycache__/*' -print0 | sort -z | xargs -0 sha256sum > /tmp/custom_nodes.sha256 && \
    find /ComfyUI/comfy /ComfyUI/comfy_extras -type f -name '*.py' -print0 | sort -z | xargs -0 sha256sum > /tmp/comfy_core.sha256

# 2. New setup_models.py and entrypoint.sh
COPY setup_models.py /setup_models.py
COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /setup_models.py /entrypoint.sh && chmod 755 /setup_models.py /entrypoint.sh && \
    bash -n /entrypoint.sh && \
    grep -q 'COMFYUI_MANAGER' /entrypoint.sh && grep -q 'MODEL_SOURCE' /setup_models.py && \
    cd / && python -c "import setup_models, worker_guard.job_guard; print('setup_models', setup_models.model_source(), \
'retries', setup_models.COPY_RANGE_RETRIES, setup_models.COPY_FILE_RETRIES)" && \
    rm -rf /worker_guard/__pycache__ /__pycache__

# 3. LAST RUN STEP: unchanged files + unchanged custom nodes + unchanged ComfyUI core + zero package drift
RUN sha256sum -c --quiet /tmp/unchanged.sha256 && \
    find /ComfyUI/custom_nodes -type f -not -path '*/__pycache__/*' -print0 \
        | sort -z | xargs -0 sha256sum > /tmp/custom_nodes_post.sha256 && \
    diff -u /tmp/custom_nodes.sha256 /tmp/custom_nodes_post.sha256 && \
    find /ComfyUI/comfy /ComfyUI/comfy_extras -type f -name '*.py' -print0 | sort -z | xargs -0 sha256sum > /tmp/comfy_core_post.sha256 && \
    diff -u /tmp/comfy_core.sha256 /tmp/comfy_core_post.sha256 && \
    /usr/bin/python3.10 -m pip freeze > /tmp/comfy_freeze_post.txt && \
    diff -u /tmp/comfy_freeze_pre.txt /tmp/comfy_freeze_post.txt || { \
        echo "CRITICAL ERROR: files, custom nodes, ComfyUI core or the Python environment changed during the v33 build!"; \
        exit 1; \
    } && \
    rm -f /tmp/comfy_freeze_pre.txt /tmp/comfy_freeze_post.txt /tmp/unchanged.sha256 /tmp/custom_nodes.sha256 \
        /tmp/custom_nodes_post.sha256 /tmp/comfy_core.sha256 /tmp/comfy_core_post.sha256 && \
    echo "OK: handler/worker_guard/workflows/custom nodes/ComfyUI core unchanged. Zero package drift."
