 "SeedVR2TemporalChunk": {
  "input": {
   "required": {
    "chunking_mode": [
     "COMFY_DYNAMICCOMBO_V3",
     {
      "options": [
       {
        "inputs": {
         "required": {}
        },
        "key": "auto"
       },
       {
        "inputs": {
         "required": {
          "frames_per_chunk": [
           "INT",
           {
            "default": 21,
            "max": 16384,
            "min": 1,
            "step": 4,
            "tooltip": "Pixel frames per temporal chunk (4n+1: 1, 5, 9, 13, ...)."
           }
          ]
         }
        },
        "key": "manual"
       }
      ],
      "tooltip": "manual = use frames_per_chunk exactly; auto = predict the largest chunk that fits free VRAM."
     }
    ],
    "latent": [
     "LATENT",
     {
      "tooltip": "The VAE-encoded SeedVR2 latent to split."
     }
    ],
    "temporal_overlap": [
     "INT",
     {
      "default": 0,
      "max": 16384,
      "min": 0,
      "tooltip": "Latent frames shared between adjacent chunks and crossfaded at merge; 0 = no overlap."
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "latent",
    "temporal_overlap",
    "chunking_mode"
   ]
  },
  "output": [
   "LATENT",
   "INT"
  ],
  "output_is_list": [
   true,
   false
  ],
  "output_name": [
   "latents",
   "temporal_overlap"
  ]
 },
