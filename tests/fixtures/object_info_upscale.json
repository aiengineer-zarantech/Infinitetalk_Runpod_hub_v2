 "SeedVR2PostProcessing": {
  "input": {
   "required": {
    "color_correction_method": [
     "COMBO",
     {
      "default": "lab",
      "multiselect": false,
      "options": [
       "lab",
       "wavelet",
       "adain",
       "none"
      ],
      "tooltip": "Method to match the generated image colors to the original image. lab: transfer color in CIELAB space, preserving detail (most faithful). wavelet: transfer low-frequency color, keeping upscaled high-frequency detail. adain: match per-channel mean/std (fastest, global tint). none: skip color transfer (geometry alignment only)."
     }
    ],
    "images": [
     "IMAGE",
     {
      "tooltip": "The generated image to process."
     }
    ],
    "original_resized_images": [
     "IMAGE",
     {
      "tooltip": "The original resized image before pre-processing, used as reference."
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "images",
    "original_resized_images",
    "color_correction_method"
   ]
  },
  "output": [
   "IMAGE"
  ],
