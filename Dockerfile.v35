# ==============================================================================
# Dockerfile.v35 - v34 code with MODEL_SOURCE=volume default (models from the network volume, as v32)
# ==============================================================================
# Same as Dockerfile.v34 except the model source: no models in the image, every model comes from the attached
# network volume (/runpod-volume/models/<folder>/<file>, copied to container disk at cold start like v32).
# MODEL_SOURCE=hf_cache on the endpoint switches to RunPod Cached Models without a rebuild.
# ==============================================================================
# Overlay on v32 by digest (like v33). Adds no models and installs nothing: image size stays ~v32.
# - MODEL_SOURCE=hf_cache: the 8 startup models are linked from the endpoint's RunPod Cached Model
#   (/runpod-volume/huggingface-cache/hub/models--<org>--<name>/snapshots/<hash>/<folder>/<file>), no copy.
#   HF_CACHE_REPO may stay unset: the only cached repo is used. A missing file or no cache at all falls back
#   to the network volume copy (HF_CACHE_FALLBACK=1). InfiniteTalk Multi stays lazy (volume or cache).
# - SeedVR2 (~7.3 GB) is copied on the first upscale job only (UPSCALE_MODELS_AT_STARTUP=1 = old behaviour).
# - separate_vocals=false skips MelBandRoFormer (backend TTS_SKIP_VOCAL_SEPARATION=1 sends it for TTS audio).
# - fp8_fast (benchmark jobs / FP8_FAST=1) also sets merge_loras=true (it failed with unmerged LoRAs).
# - Every video job logs [PROFILE] per node and one "[TIMING] stages:" line; benchmark jobs return a
#   "timing" dict (windows, s/it, stages) next to the video.
# - MODEL_LOCK (default on, MODEL_LOCK.md): locked_model_config.json, worker_guard/model_lock.py and the
#   zz_worker_mem node (custom_nodes/zz_worker_mem: gc + empty_cache without unloading the model).
# All of v33 is included (resilient copy, ComfyUI-Manager off).
#
# Build: see BUILD_V34.md. Push only to a PRIVATE repository: the v32 base keeps an old layer with a
# RunPod key in three dev scripts (deleted below, still readable in the lower layer).
ARG BASE_IMAGE=digamberjhazaran/infinitetalk-runpod@sha256:423a8e0cd3a42ca4d26d82fffbae3292f76dcd0ba988a0280bfb703bc4970652
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

# 1. Baseline: every file replaced below must be the v32 one; everything else is fingerprinted
RUN /usr/bin/python3.10 -m pip freeze > /tmp/comfy_freeze_pre.txt && \
    printf '%s\n' \
      "07b8f9bc4574aff6990ce7e1bbb50d314fd8eeda5d39fdfdd99e0deed28d56fe  /handler.py" \
      "8fe96d8694a504d5ac643429e03be9a85c857828c31a74f501ba093663734d55  /setup_models.py" \
      "51ee2f6ac2d8d0f260ffda93052317400154198a5075fbdce79d81b2664aaabe  /entrypoint.sh" \
      "0c3c2fca33fa6813796429bec0e2918034bc3994b0a3121fb0a7e31d7e1953c5  /worker_guard/accel.py" \
      "3592ee7a0731e6e51c64fb4d3e9f28209f9d0ea8b72fd8e988933b6ccf9c8a9c  /worker_guard/node_timer.py" \
      "62fede151ccccfc8bafd02c80eb9b5950826f11c03a6db3d1636c7c09c574b7e  /worker_guard/job_guard.py" \
      "ec3f3f44a95065e89e611c37c38e1270e022a59cce4bb032dfc10d1165117375  /worker_guard/comfy_api.py" \
      | sha256sum -c --quiet && \
    test ! -e /worker_guard/vocals.py && test ! -e /worker_guard/model_lock.py && \
    test ! -e /ComfyUI/custom_nodes/zz_worker_mem && \
    sha256sum /extra_model_paths.yaml /Upscale_SeedVR2.json \
        /I2V_single.json /I2V_multi.json /V2V_single.json /V2V_multi.json \
        /I2V_single_compiled.json /I2V_multi_compiled.json > /tmp/unchanged.sha256 && \
    find /worker_guard -type f -name '*.py' \
        -not -name accel.py -not -name node_timer.py -not -name job_guard.py -not -name comfy_api.py -print0 \
        | sort -z | xargs -0 sha256sum >> /tmp/unchanged.sha256 && \
    find /ComfyUI/custom_nodes -type f -not -path '*/__pycache__/*' -print0 | sort -z | xargs -0 sha256sum > /tmp/custom_nodes.sha256 && \
    find /ComfyUI/comfy /ComfyUI/comfy_extras -type f -name '*.py' -print0 | sort -z | xargs -0 sha256sum > /tmp/comfy_core.sha256 && \
    rm -f /test_worker_diag.py /test_mutations.py /download_all_models.py

# 2. v34 code
COPY handler.py setup_models.py entrypoint.sh locked_model_config.json /
COPY worker_guard/accel.py worker_guard/node_timer.py worker_guard/job_guard.py worker_guard/vocals.py \
     worker_guard/comfy_api.py worker_guard/model_lock.py /worker_guard/
COPY comfy_mem/__init__.py /ComfyUI/custom_nodes/zz_worker_mem/__init__.py
RUN sed -i 's/\r$//' /handler.py /setup_models.py /entrypoint.sh /worker_guard/*.py && \
    chmod 755 /setup_models.py /entrypoint.sh && bash -n /entrypoint.sh && \
    cd / && python -c "import setup_models, worker_guard.job_guard, worker_guard.vocals, worker_guard.model_lock as ml; \
assert not setup_models.upscale_at_startup() and setup_models.hf_cache_fallback(); \
assert ml.enabled() and ml.config()['blocks_to_swap'] == 0; \
print('v35 imports OK, model lock config', ml.config_hash())" && \
    rm -rf /worker_guard/__pycache__ /__pycache__

ENV MODEL_SOURCE=volume \
    HF_CACHE_FALLBACK=1 \
    UPSCALE_MODELS_AT_STARTUP=0

# 3. LAST RUN STEP: unchanged files + custom nodes + ComfyUI core, zero package drift
RUN sha256sum -c --quiet /tmp/unchanged.sha256 && \
    find /ComfyUI/custom_nodes -type f -not -path '*/__pycache__/*' -not -path '*/zz_worker_mem/*' -print0 | sort -z | xargs -0 sha256sum > /tmp/custom_nodes_post.sha256 && \
    diff -u /tmp/custom_nodes.sha256 /tmp/custom_nodes_post.sha256 && \
    find /ComfyUI/comfy /ComfyUI/comfy_extras -type f -name '*.py' -print0 | sort -z | xargs -0 sha256sum > /tmp/comfy_core_post.sha256 && \
    diff -u /tmp/comfy_core.sha256 /tmp/comfy_core_post.sha256 && \
    /usr/bin/python3.10 -m pip freeze > /tmp/comfy_freeze_post.txt && \
    diff -u /tmp/comfy_freeze_pre.txt /tmp/comfy_freeze_post.txt || { \
        echo "CRITICAL ERROR: files, custom nodes, ComfyUI core or the Python environment changed during the v35 build!"; \
        exit 1; \
    } && \
    rm -f /tmp/comfy_freeze_*.txt /tmp/unchanged.sha256 /tmp/custom_nodes*.sha256 /tmp/comfy_core*.sha256 && \
    echo "OK: v35 built. Only handler/setup_models/entrypoint + 6 worker_guard files + zz_worker_mem added/changed. Zero package drift."
